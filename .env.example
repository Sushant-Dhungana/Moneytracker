APP_ENV=development
APP_NAME=arthaX Backend
API_PREFIX=/api/v1
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:6543/postgres?pgbouncer=true
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_AUD=authenticated
SUPABASE_ANON_KEY=your_supabase_anon_key
AUTH_REQUIRE_EMAIL_CONFIRMATION=true
CORS_ORIGINS=http://localhost:8081,exp://127.0.0.1:8081
DB_CONNECT_TIMEOUT_SEC=5
DB_POOL_ACQUIRE_TIMEOUT_SEC=8
SUPABASE_AUTH_TIMEOUT_SEC=8

# AI orchestration (backend-owned split)
AI_TIMEOUT_SEC=25
PERSONAL_CHAT_API_ENDPOINT=https://your-ai-gateway.example.com/personal/chat
# PERSONAL_CHAT_API_KEY=your_personal_chat_api_key
# PERSONAL_CHAT_API_KEY_HEADER=x-api-key
BUSINESS_CHAT_API_ENDPOINT=https://your-ai-gateway.example.com/business/chat
# BUSINESS_CHAT_API_KEY=your_business_chat_api_key
# BUSINESS_CHAT_API_KEY_HEADER=x-api-key

# Optional global fallback (legacy single endpoint)
# CHAT_API_ENDPOINT=https://your-ai-gateway.example.com/chat
# CHAT_API_KEY=your_chat_api_key
# CHAT_API_KEY_HEADER=x-api-key

# Embedding endpoint used for business vector indexing / retrieval
# EMBEDDING_API_ENDPOINT=https://your-api.example.com/embed
# EMBEDDING_API_KEY=your_embedding_api_key
# EMBEDDING_API_KEY_HEADER=x-api-key
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024
PERSONAL_CHAT_MATCH_THRESHOLD=0.55
PERSONAL_CHAT_MATCH_COUNT=8
BUSINESS_CHAT_MATCH_THRESHOLD=0.55
BUSINESS_CHAT_MATCH_COUNT=8

# Receipt proxy (AWS Textract via backend /api/v1/receipt)
RECEIPT_AWS_ACCESS_KEY_ID=your_receipt_aws_access_key_id
RECEIPT_AWS_SECRET_ACCESS_KEY=your_receipt_aws_secret_access_key
# RECEIPT_AWS_SESSION_TOKEN=your_temporary_session_token
RECEIPT_AWS_REGION=us-east-1
# RECEIPT_TEXTRACT_ENDPOINT=https://textract.us-east-1.amazonaws.com
RECEIPT_TIMEOUT_SEC=90
